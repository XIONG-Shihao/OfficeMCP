{
  "name": "officemcp-local-preview",
  "version": "0.18.0-preview.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Four-format MCP document tools with validated DOCX/XLSX/PPTX edits",
  "engines": {
    "node": ">=24.12.0 <25",
    "bun": ">=1.3.13 <2"
  },
  "bin": {
    "officemcp-preview": "src/cli.mjs"
  },
  "files": [
    "src",
    "contracts",
    "agent",
    "README.md",
    "docs",
    "npm-shrinkwrap.json",
    "verification.json",
    ".generated/document-core",
    ".generated/native",
    ".generated/docx-core"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "doctor": "node src/cli.mjs doctor",
    "test:package": "node scripts/verify-package.mjs",
    "test:samples": "node scripts/evaluate-samples.mjs",
    "test:engines": "node scripts/verify-engines.mjs",
    "test:response": "node scripts/evaluate-response.mjs",
    "prepack": "node scripts/prepare-core.mjs",
    "pretest": "node scripts/prepare-core.mjs",
    "prebuild": "node scripts/prepare-core.mjs",
    "prepare:engines": "node scripts/prepare-core.mjs",
    "test:consumer": "node scripts/test/consumer-package.mjs",
    "test:docx:consumer": "node scripts/test/docx-consumer-package.mjs",
    "test:docx:workflows": "node scripts/test/docx-product-workflows.mjs",
    "test:docx:agents": "node scripts/test/docx-agent-workflows.mjs",
    "test:bun": "bun test --timeout 120000 test/"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@noble/hashes": "2.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@superdoc/sdk": "2.2.1",
    "@univerjs/core": "0.25.2",
    "@univerjs/engine-formula": "0.25.2",
    "@univerjs/sheets": "0.25.2",
    "@univerjs/sheets-formula": "0.25.2",
    "@univerjs/sheets-table": "0.25.2",
    "@xmldom/xmldom": "0.8.15",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "mupdf": "1.28.1",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "rxjs": "7.8.2",
    "saxes": "6.0.0",
    "zod": "4.4.3"
  },
  "exports": {
    ".": {
      "types": "./src/sdk.d.mts",
      "import": "./src/sdk.mjs"
    },
    "./storage": {
      "types": "./src/storage.d.mts",
      "import": "./src/storage.mjs"
    },
    "./authoring": "./src/authoring.mjs"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@univerjs/core": {
      "nanoid": "5.1.16"
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "docx": "9.5.1"
  },
  "imports": {
    "#document-core/*": "./.generated/document-core/*",
    "#docx-core": "./.generated/docx-core/engine.mjs",
    "#docx-observer": "./.generated/docx-core/process-observer.mjs"
  },
  "bundleDependencies": [
    "@modelcontextprotocol/server",
    "@pdf-lib/fontkit",
    "@superdoc/sdk",
    "@univerjs/core",
    "@univerjs/engine-formula",
    "@univerjs/sheets",
    "@univerjs/sheets-formula",
    "@univerjs/sheets-table",
    "@xmldom/xmldom",
    "exceljs",
    "fflate",
    "mupdf",
    "pdf-lib",
    "pptxgenjs",
    "rxjs",
    "zod",
    "@noble/hashes",
    "saxes"
  ]
}
